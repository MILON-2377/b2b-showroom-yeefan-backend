```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# =========================
# Virtual Environment
# =========================
.venv/
venv/
env/
ENV/

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Testing
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =========================
# Type Checking / Linters
# =========================
.mypy_cache/
.pyright/
.ruff_cache/

# =========================
# IDE / Editors
# =========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# =========================
# Build / Packaging
# =========================
build/
dist/
*.egg-info/
.eggs/

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Local Database / Runtime
# =========================
*.sqlite
*.sqlite3
*.db

# =========================
# Alembic
# =========================
# Keep migration files tracked.
# Do NOT ignore alembic/versions/

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
```
